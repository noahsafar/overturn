# ─── Database ───────────────────────────────────────────────────────────────
# Local dev: docker-compose.dev.yml provides postgres+pgvector on 5432
DATABASE_URL=postgresql://claimwell:claimwell@localhost:5432/claimwell?schema=public

# ─── PHI encryption (app-layer envelope encryption) ─────────────────────────
# 32-byte base64-encoded key. Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHI_ENC_KEY=

# ─── Auth: Clerk (HIPAA tier — sign BAA before storing real PHI) ─────────────
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# If both are unset, web app runs in DEV_AUTH mode with a stub user.
DEV_AUTH=true

# ─── LLM: Anthropic Claude (ZDR + BAA required before real PHI) ─────────────
ANTHROPIC_API_KEY=
# Set to "true" to send the ZDR/no-retention header on requests.
ANTHROPIC_ZDR=true
ANTHROPIC_MODEL_DRAFT=claude-opus-4-7
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5-20251001
# If unset, the worker uses deterministic stub responses so tests still pass.

# ─── Browser automation ─────────────────────────────────────────────────────
BROWSERBASE_API_KEY=
# "BROWSERBASE" for prod, "LOCAL" for headed local Playwright, "FAKE" for the
# bundled local fake-portal used by e2e tests.
STAGEHAND_ENV=FAKE

# ─── Temporal ───────────────────────────────────────────────────────────────
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=appeals

# ─── Object storage (S3 — sign BAA with AWS) ────────────────────────────────
S3_BUCKET=claimwell-dev
AWS_REGION=us-east-1
# In dev we use a local filesystem stand-in under ./artifacts/

# ─── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ─── Misc ───────────────────────────────────────────────────────────────────
NODE_ENV=development
WORKER_INTERNAL_URL=http://localhost:8001

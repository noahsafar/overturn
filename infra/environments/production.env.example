# Production Environment Configuration
# Copy this file to production.env and fill in real values
# WARNING: Never commit real credentials to git!

# ─── Database ───────────────────────────────────────────────────────────────
# Production RDS instance
DATABASE_URL=postgresql://overturn:PASSWORD@overturn-production.XXX.us-east-1.rds.amazonaws.com:5432/overturn

# ─── PHI encryption (app-layer envelope encryption) ─────────────────────────
# Generated during initial setup, stored in Secrets Manager
PHI_ENC_KEY=YOUR_BASE64_ENCODED_32_BYTE_KEY_HERE

# ─── Auth: Clerk (HIPAA tier — BAA signed) ────────────────────────────────────
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY

# ─── LLM: Anthropic Claude (ZDR + BAA configured) ────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY
ANTHROPIC_ZDR=true
ANTHROPIC_MODEL_DRAFT=claude-opus-4-7
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5-20251001

# ─── Browser automation ───────────────────────────────────────────────────────
BROWSERBASE_API_KEY=YOUR_BROWSERBASE_API_KEY
STAGEHAND_ENV=BROWSERBASE

# ─── Temporal ───────────────────────────────────────────────────────────────
TEMPORAL_HOST=temporal.production.overturn.com
TEMPORAL_NAMESPACE=production
TEMPORAL_TASK_QUEUE=appeals-production

# ─── Object storage (S3 — BAA signed with AWS) ────────────────────────────────
S3_BUCKET=overturn-production-artifacts
AWS_REGION=us-east-1

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_HOST=https://langfuse.overturn.com

# ─── Stripe (billing — BAA signed) ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ─── eFax (Documo — BAA signed) ───────────────────────────────────────────────
DOCUMO_API_KEY=YOUR_DOCUMO_API_KEY
DOCUMO_API_BASE=https://api.documo.com/v1

# ─── Mail-house (Lob — BAA signed) ────────────────────────────────────────────
LOB_API_KEY=YOUR_LOB_API_KEY
LOB_API_BASE=https://api.lob.com/v1

# ─── Transactional email (Resend — BAA signed) ────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=appeals@overturn.com
RESEND_REPLY_TO=support@overturn.com

# ─── Clearinghouse SFTP ───────────────────────────────────────────────────────
CLEARINGHOUSE_POLL_INTERVAL_S=300

# ─── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV=production
WORKER_INTERNAL_URL=http://overturn-worker-production:8001

# ─── Production-specific ────────────────────────────────────────────────────────
OVERTURN_ADMIN_EMAILS=admin@overturn.com,oncall@overturn.com
